# Calm Ledger - Environment Configuration
# Copy this file to .env.local for local development with your Supabase project keys.
# (If omitted, the app will run cleanly with offline localStorage persistence)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
